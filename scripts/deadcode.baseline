# Baseline format: "<file> <func>" (no line numbers). Unreachable from the
# phi binary by design; kept for API or external consumers.
cmd/exit.go exitError.silent

# ext/go/pxb wire helpers are a public SDK consumed by external extension
# binaries (and by the nested module's own tests, which deadcode -test cannot
# see from this module's roots). The ext/go/phi SDK is now outside this module's
# analysis entirely (nothing in the host imports it). msg_gen.go is generated by
# pxbgen, which deadcode skips, so those messages surface here only through the
# helpers they call.
ext/go/pxb/codec.go ReadFrame
ext/go/pxb/fields.go fieldWriter.putU16s
ext/go/pxb/fields.go u16sSize
ext/go/pxb/types.go EventCode
ext/go/pxb/types.go EventName
