{
  "name": "git",
  "description": "the distributed version control system",
  "subcommands": [
    {
      "name": "add",
      "description": "stage changes for the next commit",
      "options": [
        {
          "names": [
            "--all",
            "-A"
          ],
          "description": "stage every change, including deletions"
        },
        {
          "names": [
            "--patch",
            "-p"
          ],
          "description": "pick hunks to stage interactively"
        },
        {
          "names": [
            "--update",
            "-u"
          ],
          "description": "stage modified and deleted tracked files"
        },
        {
          "names": [
            "--dry-run",
            "-n"
          ],
          "description": "show what would be staged"
        },
        {
          "names": [
            "--force",
            "-f"
          ],
          "description": "stage ignored files"
        },
        {
          "names": [
            "--intent-to-add",
            "-N"
          ],
          "description": "record the path without its content"
        }
      ],
      "noOptionAfterArgument": true
    },
    {
      "name": "branch",
      "description": "list, create, or delete branches",
      "options": [
        {
          "names": [
            "--all",
            "-a"
          ],
          "description": "list local and remote branches"
        },
        {
          "names": [
            "--remote",
            "-r"
          ],
          "description": "list remote branches"
        },
        {
          "names": [
            "--delete",
            "-d"
          ],
          "description": "delete a fully merged branch",
          "args": [
            {
              "name": "branch-name"
            }
          ]
        },
        {
          "names": [
            "--move",
            "-m"
          ],
          "description": "rename a branch",
          "args": [
            {
              "name": "old"
            },
            {
              "name": "new"
            }
          ]
        },
        {
          "names": [
            "--list",
            "-l"
          ],
          "description": "list branches matching a pattern",
          "args": [
            {
              "name": "pattern",
              "optional": true
            }
          ]
        },
        {
          "names": [
            "--verbose",
            "-v"
          ],
          "description": "show each branch's last commit"
        },
        {
          "names": [
            "--contains"
          ],
          "description": "only branches containing a commit",
          "args": [
            {
              "name": "commit"
            }
          ]
        }
      ]
    },
    {
      "name": "checkout",
      "description": "switch branches or restore files",
      "options": [
        {
          "names": [
            "--branch",
            "-b"
          ],
          "description": "create and switch to a new branch",
          "args": [
            {
              "name": "branch-name"
            }
          ]
        },
        {
          "names": [
            "--detach"
          ],
          "description": "check out the commit instead of a branch"
        },
        {
          "names": [
            "--force",
            "-f"
          ],
          "description": "throw away local changes"
        },
        {
          "names": [
            "--quiet",
            "-q"
          ],
          "description": "suppress progress messages"
        },
        {
          "names": [
            "--track",
            "-t"
          ],
          "description": "set up a tracking branch"
        },
        {
          "names": [
            "--orphan"
          ],
          "description": "start a new branch with no history",
          "args": [
            {
              "name": "branch-name"
            }
          ]
        }
      ],
      "args": [
        {
          "name": "branch",
          "generator": "branches"
        }
      ]
    },
    {
      "name": "clean",
      "description": "remove untracked files from the working tree",
      "noOptionAfterArgument": false,
      "options": [
        {
          "names": [
            "--dry-run",
            "-n"
          ],
          "description": "show what would be removed"
        },
        {
          "names": [
            "--force",
            "-f"
          ],
          "description": "remove untracked files"
        },
        {
          "names": [
            "--directories",
            "-d"
          ],
          "description": "remove untracked directories too"
        },
        {
          "names": [
            "--interactive",
            "-i"
          ],
          "description": "choose what to remove interactively"
        },
        {
          "names": [
            "--ignored",
            "-X"
          ],
          "description": "remove ignored files only"
        },
        {
          "names": [
            "--exclude",
            "-e"
          ],
          "description": "skip paths matching a pattern",
          "args": [
            {
              "name": "pattern"
            }
          ]
        }
      ]
    },
    {
      "name": "clone",
      "description": "copy a repository into a new directory",
      "options": [
        {
          "names": [
            "--depth"
          ],
          "description": "shallow clone with limited history",
          "args": [
            {
              "name": "depth"
            }
          ]
        },
        {
          "names": [
            "--branch",
            "-b"
          ],
          "description": "check out this branch first",
          "args": [
            {
              "name": "branch-name"
            }
          ]
        },
        {
          "names": [
            "--recursive"
          ],
          "description": "clone submodules too"
        },
        {
          "names": [
            "--single-branch"
          ],
          "description": "clone only one branch"
        },
        {
          "names": [
            "--bare"
          ],
          "description": "make a bare repository"
        },
        {
          "names": [
            "--mirror"
          ],
          "description": "mirror all refs, including remote-tracking"
        }
      ],
      "noOptionAfterArgument": true
    },
    {
      "name": "commit",
      "description": "record changes to the repository",
      "options": [
        {
          "names": [
            "--message",
            "-m"
          ],
          "description": "use the given text as the commit message",
          "args": [
            {
              "name": "message"
            }
          ]
        },
        {
          "names": [
            "--all",
            "-a"
          ],
          "description": "stage modified and deleted tracked files first"
        },
        {
          "names": [
            "--amend"
          ],
          "description": "replace the last commit instead of adding one"
        },
        {
          "names": [
            "--no-verify",
            "-n"
          ],
          "description": "skip pre-commit and commit-msg hooks"
        },
        {
          "names": [
            "--patch",
            "-p"
          ],
          "description": "pick hunks to commit interactively"
        },
        {
          "names": [
            "--fixup"
          ],
          "description": "mark the commit as a fixup of another",
          "args": [
            {
              "name": "commit"
            }
          ]
        },
        {
          "names": [
            "--squash"
          ],
          "description": "fold the commit into another on rebase",
          "args": [
            {
              "name": "commit"
            }
          ]
        },
        {
          "names": [
            "--signoff",
            "-s"
          ],
          "description": "add a Signed-off-by trailer"
        },
        {
          "names": [
            "--dry-run"
          ],
          "description": "show what would be committed"
        },
        {
          "names": [
            "--interactive",
            "-i"
          ],
          "description": "choose what to commit interactively"
        }
      ]
    },
    {
      "name": "diff",
      "description": "show changes between commits, the index, and the work tree",
      "options": [
        {
          "names": [
            "--staged",
            "--cached"
          ],
          "description": "compare against the index instead of the work tree"
        },
        {
          "names": [
            "--stat"
          ],
          "description": "shorten the output to a diffstat"
        },
        {
          "names": [
            "--name-only"
          ],
          "description": "list changed file names only"
        },
        {
          "names": [
            "--name-status"
          ],
          "description": "list changed files with their status"
        },
        {
          "names": [
            "--word-diff"
          ],
          "description": "highlight word changes instead of lines"
        },
        {
          "names": [
            "--color"
          ],
          "description": "color the output",
          "args": [
            {
              "name": "when",
              "optional": true
            }
          ]
        },
        {
          "names": [
            "--no-index"
          ],
          "description": "compare two unrelated paths"
        }
      ],
      "noOptionAfterArgument": true,
      "args": [
        {
          "name": "commit",
          "generator": "commits"
        }
      ]
    },
    {
      "name": "fetch",
      "description": "download objects and refs from another repository",
      "options": [
        {
          "names": [
            "--all"
          ],
          "description": "fetch every remote"
        },
        {
          "names": [
            "--prune",
            "-p"
          ],
          "description": "delete refs that no longer exist upstream"
        },
        {
          "names": [
            "--tags"
          ],
          "description": "fetch all tags"
        },
        {
          "names": [
            "--depth"
          ],
          "description": "limit history to this many commits",
          "args": [
            {
              "name": "depth"
            }
          ]
        },
        {
          "names": [
            "--force",
            "-f"
          ],
          "description": "allow non-fast-forward updates"
        }
      ]
    },
    {
      "name": "log",
      "description": "show commit logs",
      "options": [
        {
          "names": [
            "--oneline"
          ],
          "description": "one commit per line"
        },
        {
          "names": [
            "--graph"
          ],
          "description": "draw the branch graph"
        },
        {
          "names": [
            "--all"
          ],
          "description": "start from every ref"
        },
        {
          "names": [
            "--stat"
          ],
          "description": "show a diffstat for each commit"
        },
        {
          "names": [
            "--patch",
            "-p"
          ],
          "description": "show each commit's diff"
        },
        {
          "names": [
            "--follow"
          ],
          "description": "follow a file across renames",
          "args": [
            {
              "name": "file"
            }
          ]
        },
        {
          "names": [
            "--author"
          ],
          "description": "only commits by this author",
          "args": [
            {
              "name": "pattern"
            }
          ]
        },
        {
          "names": [
            "--grep"
          ],
          "description": "only commits whose message matches",
          "args": [
            {
              "name": "pattern"
            }
          ]
        },
        {
          "names": [
            "--count",
            "-n"
          ],
          "description": "limit the number of commits",
          "args": [
            {
              "name": "count"
            }
          ]
        },
        {
          "names": [
            "--since"
          ],
          "description": "only commits newer than a date",
          "args": [
            {
              "name": "date"
            }
          ]
        },
        {
          "names": [
            "--until"
          ],
          "description": "only commits older than a date",
          "args": [
            {
              "name": "date"
            }
          ]
        }
      ],
      "noOptionAfterArgument": true,
      "args": [
        {
          "name": "commit",
          "generator": "commits"
        }
      ]
    },
    {
      "name": "merge",
      "description": "join development histories together",
      "options": [
        {
          "names": [
            "--no-ff"
          ],
          "description": "always create a merge commit"
        },
        {
          "names": [
            "--ff-only"
          ],
          "description": "refuse unless a fast-forward is possible"
        },
        {
          "names": [
            "--squash"
          ],
          "description": "stage the merge as one set of changes"
        },
        {
          "names": [
            "--abort"
          ],
          "description": "abandon the merge in progress"
        },
        {
          "names": [
            "--continue"
          ],
          "description": "finish the merge after resolving conflicts"
        },
        {
          "names": [
            "--no-commit"
          ],
          "description": "stop before making the merge commit"
        },
        {
          "names": [
            "--strategy",
            "-s"
          ],
          "description": "use this merge strategy",
          "args": [
            {
              "name": "strategy"
            }
          ]
        }
      ],
      "args": [
        {
          "name": "branch",
          "generator": "branches"
        }
      ]
    },
    {
      "name": "pull",
      "description": "fetch from and integrate with another repository",
      "options": [
        {
          "names": [
            "--rebase",
            "-r"
          ],
          "description": "rebase local commits instead of merging"
        },
        {
          "names": [
            "--ff-only"
          ],
          "description": "refuse unless a fast-forward is possible"
        },
        {
          "names": [
            "--no-rebase"
          ],
          "description": "merge instead of rebasing"
        },
        {
          "names": [
            "--autostash"
          ],
          "description": "stash before and pop after"
        },
        {
          "names": [
            "--depth"
          ],
          "description": "deepen the clone",
          "args": [
            {
              "name": "depth"
            }
          ]
        }
      ]
    },
    {
      "name": "push",
      "description": "update remote refs along with associated objects",
      "options": [
        {
          "names": [
            "--force",
            "-f"
          ],
          "description": "overwrite the remote ref"
        },
        {
          "names": [
            "--force-with-lease"
          ],
          "description": "force, unless the remote moved on"
        },
        {
          "names": [
            "--set-upstream",
            "-u"
          ],
          "description": "record the remote as the upstream"
        },
        {
          "names": [
            "--tags"
          ],
          "description": "push all tags"
