            {
              "name": "ref"
            }
          ]
        },
        {
          "names": [
            "--dry-run",
            "-n"
          ],
          "description": "show what would be pushed"
        },
        {
          "names": [
            "--all"
          ],
          "description": "push every branch"
        }
      ]
    },
    {
      "name": "rebase",
      "description": "reapply commits on top of another base",
      "options": [
        {
          "names": [
            "--interactive",
            "-i"
          ],
          "description": "edit the commit list"
        },
        {
          "names": [
            "--autosquash"
          ],
          "description": "reorder fixup and squash commits"
        },
        {
          "names": [
            "--autostash"
          ],
          "description": "stash before and pop after"
        },
        {
          "names": [
            "--continue"
          ],
          "description": "resume after resolving conflicts"
        },
        {
          "names": [
            "--abort"
          ],
          "description": "restore the branch and HEAD"
        },
        {
          "names": [
            "--skip"
          ],
          "description": "drop the failing commit and continue"
        },
        {
          "names": [
            "--onto"
          ],
          "description": "rebase onto a different base",
          "args": [
            {
              "name": "commit"
            }
          ]
        }
      ],
      "args": [
        {
          "name": "branch",
          "generator": "branches"
        }
      ]
    },
    {
      "name": "remote",
      "description": "manage the set of tracked repositories",
      "subcommands": [
        {
          "name": "add",
          "description": "add a remote",
          "options": [
            {
              "names": [
                "--fetch",
                "-f"
              ],
              "description": "fetch right after adding"
            },
            {
              "names": [
                "--track",
                "-t"
              ],
              "description": "track only this branch",
              "args": [
                {
                  "name": "branch"
                }
              ]
            }
          ]
        },
        {
          "name": "remove",
          "description": "remove a remote",
          "options": [
            {
              "names": [
                "--all"
              ],
              "description": "remove mirrored refs too"
            }
          ]
        },
        {
          "name": "show",
          "description": "show a remote's URLs and branches"
        },
        {
          "name": "prune",
          "description": "delete stale remote-tracking branches"
        },
        {
          "name": "set-url",
          "description": "change a remote's URL"
